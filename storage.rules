rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }
    function myCompanyId() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.companyId;
    }
    function sameCompany(companyId) {
      return isSignedIn() && myCompanyId() == companyId;
    }
    match /companies/{companyId}/{allPaths=**} {
      allow read: if sameCompany(companyId);
      allow write: if sameCompany(companyId);
      allow delete: if sameCompany(companyId);
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
