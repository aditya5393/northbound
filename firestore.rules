rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }
    // Safe - returns null if user doc does not exist yet (new user, first login)
    // This fixes sign-in loop: old getUser() failed when doc did not exist yet
    function userExists() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function getUserData() {
      return userExists() ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data : null;
    }
    function myCompanyId() {
      return userExists() ? getUserData().companyId : null;
    }
    function myRole() {
      return userExists() ? getUserData().role : null;
    }
    function sameCompany(companyId) {
      return isSignedIn() && userExists() && myCompanyId() == companyId;
    }
    function isOwner(companyId) {
      return sameCompany(companyId) && myRole() == 'owner';
    }
    function isManagerOrOwner(companyId) {
      return sameCompany(companyId) && myRole() in ['owner', 'manager', 'co-owner', 'staff'];
    }
    function validCompanyId(companyId) {
      return companyId is string && companyId.size() > 0;
    }

    // FIXED USERS - New user can create own doc WITHOUT companyId
    // Old rule required companyId on create, so first Google login was blocked
    // and sign-in never completed. Now self create/update allowed.
    match /users/{userId} {
      // Self can always read own doc, even if it has no companyId yet
      allow get: if isSignedIn() && request.auth.uid == userId;
      // Owner can read team member doc in same company (only if owner doc exists)
      allow get: if isSignedIn() && userExists() && myRole() == 'owner' && resource.data.companyId == myCompanyId();
      allow list: if false;
      // New user creates own doc - NO companyId required here
      allow create: if isSignedIn() && request.auth.uid == userId;
      // Self can update own doc to set companyId after Create Company
      // Owner can also update team member
      allow update: if isSignedIn() && (request.auth.uid == userId || (userExists() && myRole() == 'owner'));
      allow delete: if false;
    }

    match /companies/{companyId} {
      allow read: if sameCompany(companyId);
      allow create: if isSignedIn() && validCompanyId(companyId);
      allow update: if isOwner(companyId);
      allow delete: if false;
    }

    match /companies/{companyId}/trips/{tripId} {
      allow read: if sameCompany(companyId);
      allow create: if isManagerOrOwner(companyId) && request.resource.data.companyId == companyId;
      allow update: if isManagerOrOwner(companyId) && request.resource.data.companyId == companyId;
      allow delete: if isOwner(companyId);
    }

    match /companies/{companyId}/customers/{customerId} {
      allow read: if sameCompany(companyId);
      allow create: if isManagerOrOwner(companyId) && request.resource.data.companyId == companyId;
      allow update: if isManagerOrOwner(companyId) && request.resource.data.companyId == companyId;
      allow delete: if isOwner(companyId);
    }

    match /companies/{companyId}/enrollments/{enrId} {
      allow read: if sameCompany(companyId);
      allow create: if isManagerOrOwner(companyId) && request.resource.data.companyId == companyId;
      allow update: if isManagerOrOwner(companyId) && request.resource.data.companyId == companyId;
      allow delete: if isOwner(companyId);
    }

    match /companies/{companyId}/payments/{paymentId} {
      allow read: if sameCompany(companyId);
      allow create: if isManagerOrOwner(companyId) && request.resource.data.companyId == companyId && request.resource.data.amount is number && request.resource.data.amount > 0;
      allow update: if isManagerOrOwner(companyId) && request.resource.data.companyId == companyId;
      allow delete: if false;
    }

    match /companies/{companyId}/expenses/{expenseId} {
      allow read: if sameCompany(companyId);
      allow create: if isManagerOrOwner(companyId) && request.resource.data.companyId == companyId;
      allow update: if isManagerOrOwner(companyId) && request.resource.data.companyId == companyId;
      allow delete: if isOwner(companyId);
    }

    match /companies/{companyId}/boarding/{boardingId} {
      allow read: if sameCompany(companyId);
      allow create: if isManagerOrOwner(companyId) && request.resource.data.companyId == companyId;
      allow update: if isManagerOrOwner(companyId) && request.resource.data.companyId == companyId;
      allow delete: if isOwner(companyId);
    }

    match /companies/{companyId}/bills/{billId} {
      allow read: if sameCompany(companyId);
      allow create: if isManagerOrOwner(companyId) && request.resource.data.companyId == companyId;
      allow update: if isManagerOrOwner(companyId) && request.resource.data.companyId == companyId;
      allow delete: if isOwner(companyId);
    }

    match /companies/{companyId}/{collection}/{docId} {
      allow read: if sameCompany(companyId);
      allow create: if isManagerOrOwner(companyId) && request.resource.data.companyId == companyId;
      allow update: if isManagerOrOwner(companyId) && request.resource.data.companyId == companyId;
      allow delete: if isOwner(companyId);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
